{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.alessiolucini/binsight",
  "title": "BinSight",
  "description": "The AI X-ray for any file: what is it, what does it hide, what changed. Static reverse-engineering intelligence via CLI and MCP. Built on REA.",
  "websiteUrl": "https://github.com/Alessiolucini/binsight",
  "repository": {
    "url": "https://github.com/Alessiolucini/binsight",
    "source": "github"
  },
  "version": "6.5.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "binsight",
      "version": "6.5.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
